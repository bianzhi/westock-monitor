# ============================================================
# Westock Monitor 环境变量配置示例
# 用法：cp .env.example .env 后修改，启动时自动加载
# ============================================================

# ----------------------------------------------------------
# westock-data CLI
# ----------------------------------------------------------
# westock-data npm 包名与版本
# WESTOCK_PKG=westock-data-skillhub@1.0.5
# 单次 CLI 调用超时 (秒)
# WESTOCK_TIMEOUT=30
# 批量查询每批板块数
# WESTOCK_BATCH_SIZE=20
# 并发查询线程数
# WESTOCK_WORKERS=8

# ----------------------------------------------------------
# 强度判定
# ----------------------------------------------------------
# 强度判定窗口天数（n=3/5/10/20）
# STRENGTH_WINDOW_N=5
# 表头展示天数
# DISPLAY_DAYS=5
# 近3日/近5日汇总窗口
# SUMMARY_3D=3
# SUMMARY_5D=5

# ----------------------------------------------------------
# 成交额口径
# ----------------------------------------------------------
# "main" = 主力口径 | "all" = 全口径（推荐） | "auto" = 优先 main
# TURNOVER_METHOD=all

# ----------------------------------------------------------
# 采集间隔
# ----------------------------------------------------------
# 分钟级采集间隔 (秒)
# MINUTE_INTERVAL=60
# 非交易时段轮询间隔 (秒)
# IDLE_SLEEP=30
# 流通市值日级采集时点 (HH:MM，逗号分隔)
# CIRC_MV_COLLECT_TIMES=09:15,15:05
# 流通市值采集兜底检查间隔 (秒)
# CIRC_MV_CHECK_INTERVAL=300

# ----------------------------------------------------------
# 数据保留
# ----------------------------------------------------------
# 分钟级数据缓存天数
# MINUTE_CACHE_DAYS=5

# ----------------------------------------------------------
# 服务
# ----------------------------------------------------------
# API_HOST=0.0.0.0
# API_PORT=8200

# CORS 允许的源（逗号分隔，生产部署必须配置）
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
